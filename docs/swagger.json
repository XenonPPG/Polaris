{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API Gateway for the Polaris project",
        "title": "Polaris API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/ingest": {
            "post": {
                "description": "Accepts content (name, data, type) and passes it to the processing pipeline for indexing",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "content"
                ],
                "summary": "Ingest content",
                "parameters": [
                    {
                        "description": "Content to ingest",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.IngestRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "content ingested successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Failed to ingest content",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/retrieve": {
            "get": {
                "description": "Searches previously ingested content based on a text query",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "content"
                ],
                "summary": "Retrieve relevant content",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search query",
                        "name": "query",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controllers.RetrieveResponse"
                        }
                    },
                    "400": {
                        "description": "Empty query",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve content",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controllers.IngestRequest": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "controllers.RetrieveResponse": {
            "type": "object",
            "properties": {
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controllers.RetrieveResultItem"
                    }
                }
            }
        },
        "controllers.RetrieveResultItem": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "string"
                },
                "similarity": {
                    "type": "number"
                },
                "source_id": {
                    "type": "integer"
                },
                "type": {
                    "type": "string"
                }
            }
        }
    }
}